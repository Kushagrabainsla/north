# .env.example  -  copy to .env and fill in real values. Never commit .env.
#
# All variables are read by config/settings.py (pydantic-settings).
# Prefix: NORTH_  e.g. field `openrouter_api_key` → NORTH_OPENROUTER_API_KEY
#
# NORTH_HOME, NORTH_SECRET, and NORTH_ENV use their conventional direct names.
# The workspace setting remains NORTH_NORTH_WORKSPACE for compatibility.

# ── Required ──────────────────────────────────────────────────────────────────

# Your OpenRouter API key. Used for LLM inference AND voice transcription.
# Get one at https://openrouter.ai/keys
NORTH_OPENROUTER_API_KEY=sk-or-your-key-here

# ── Security ──────────────────────────────────────────────────────────────────

# Pre-shared secret for CLI ↔ server authentication.
# Auto-generated and stored in $NORTH_HOME/secret.key on first run  -  you don't
# need to set this unless you're running the CLI and server on separate machines.
# NORTH_SECRET=your-secret-here

# ── Paths ─────────────────────────────────────────────────────────────────────

# Root directory where north stores all runtime data:
# ledger.db, jobs.db, inference_cache.json, secret.key, context/, tasks/
# Default: ~/.north
# NORTH_HOME=~/.north

# ── Runtime environment ───────────────────────────────────────────────────────

# development | production | test
# Default: development
# NORTH_ENV=development

# Test mode does not run autonomous workers or scan personal files by default.
# These opt-ins are useful only for end-to-end tests that require those effects.
# NORTH_AUTONOMOUS_BACKGROUND_TASKS_ENABLED=false
# NORTH_ONBOARDING_ENABLED=false

# ── Tuning ────────────────────────────────────────────────────────────────────

# How often the job processor polls jobs.db, in seconds. Default: 5
# NORTH_JOB_POLL_INTERVAL_SECONDS=5

# Timeout waiting for an agent to respond, in seconds. Default: 30
# NORTH_AGENT_READ_TIMEOUT_SECONDS=30

# Days before completed task internals are cleaned up. Default: 365
# The final response remains in the ledger permanently.
# NORTH_TASK_CLEANUP_COMPLETED_DAYS=365

# Days before failed task internals are cleaned up. Default: 365
# NORTH_TASK_CLEANUP_FAILED_DAYS=365

# Days before generated task artifacts are cleaned up. Default: 365
# NORTH_HANDOFF_RETENTION_DAYS=365

# How often the inference router refreshes model pool membership, in hours. Default: 6
# NORTH_INFERENCE_POOL_REFRESH_INTERVAL_HOURS=6

# ── Confidence scoring ────────────────────────────────────────────────────────

# How much confidence increases when a tool use is confirmed helpful. Default: 0.05
# NORTH_CONFIDENCE_INCREASE_PER_HELPFUL_USE=0.05

# How much confidence decreases when a tool use is unhelpful. Default: 0.03
# NORTH_CONFIDENCE_DECREASE_PER_UNHELPFUL_USE=0.03

# Confidence threshold above which tool use is auto-approved. Default: 0.8
# NORTH_CONFIDENCE_AUTO_APPROVE_THRESHOLD=0.8

# ── Telegram gateway ────────────────────────────────────────────────────────────

# Bot token from https://t.me/BotFather. When set, north polls Telegram for
# messages and routes them through the agent pipeline, sending results back.
# NORTH_TELEGRAM_BOT_TOKEN=your-bot-token-here

# ── OpenCode Zen inference ───────────────────────────────────────────────────

# API key from https://opencode.ai/auth. When set, north can use OpenCode Zen's
# free-tier models (kimi-k2.5-free, glm-5-free, etc.) for inference.
# NORTH_OPENCODE_ZEN_API_KEY=your-opencode-key-here

# ── Anthropic (Claude) inference ─────────────────────────────────────────────

# API key from https://console.anthropic.com/settings/keys. When set, north
# can route to Claude models directly (paid - no free tier, unlike the other
# direct-provider keys above).
# NORTH_ANTHROPIC_API_KEY=sk-ant-your-key-here
