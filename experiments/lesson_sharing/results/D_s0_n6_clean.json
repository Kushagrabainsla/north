 "lessons": [
  {
   "number": 1,
   "text": "Ledgerly due_date must use slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t00",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 2
  },
  {
   "number": 2,
   "text": "Ledgerly create_invoice requires due_date in slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 3,
   "text": "Ledgerly create_invoice requires due_date in slash format (e.g. 09/03/2027), not ISO hyphens.",
   "author": "t03",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 2
  },
  {
   "number": 4,
   "text": "Ledgerly create_invoice requires due_date in slash format (e.g., 10/19/2027), not ISO hyphens.",
   "author": "t05",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 5,
   "text": "If create_invoice returns E104 unknown field 'quantity', use qty for the line-item quantity field.",
   "author": "t03",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 6,
   "text": "The documented MM/DD/YYYY slash format was rejected for 02/13/2027; likely use DD/MM/YYYY instead.",
   "author": "t02",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "When create_invoice returns E104 unknown field 'quantity', use qty; DD/MM/YYYY slash date (e.g. 19/10/2027) passed date validation.",
   "author": "t05",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 8,
   "text": "Invoice line item unit_price must be integer minor units (cents), not decimal dollars.",
   "author": "t02",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 9,
   "text": "create_invoice unit_price must be integer minor units (cents), e.g. $257.75 => 25775; qty is the quantity field.",
   "author": "t03",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "create_invoice unit_price must be integer minor units (cents), e.g. $60.75 => 6075; qty is the quantity field.",
   "author": "t05",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "create_invoice accepts DD/MM/YYYY dates, qty for line quantity, and unit_price as integer cents.",
   "author": "t06",
   "posted": 9,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 12,
   "text": "send_invoice requires the customer's billing_email, not the primary email; E302 recipient not permitted otherwise.",
   "author": "t03",
   "posted": 12,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  }
 ]
