 "lessons": [
  {
   "number": 1,
   "text": "Ledgerly create_invoice requires due_date in MM/DD/YYYY slash format, not ISO YYYY-MM-DD.",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 2
  },
  {
   "number": 2,
   "text": "Ledgerly due_date must use slashes (e.g., 09/24/2027), not ISO hyphens.",
   "author": "t03",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 3,
   "text": "Ledgerly create_invoice requires due_date formatted with slashes (e.g. MM/DD/YYYY), not ISO hyphens.",
   "author": "t04",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 4,
   "text": "Ledgerly due_date must use slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t05",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 5,
   "text": "For sending invoices, use the customer's billing_email rather than the general email when both are present.",
   "author": "t00",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 6,
   "text": "For sending an invoice, use the customer's billing_email rather than the primary email when available.",
   "author": "t01",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "When using slash-formatted dates, DD/MM/YYYY may be accepted; an E104 revealed line items reject quantity and likely require qty.",
   "author": "t02",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 8,
   "text": "create_invoice accepts due_date in DD/MM/YYYY format (e.g. 25/12/2027), despite prior MM/DD notes.",
   "author": "t04",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 9,
   "text": "Ledgerly create_invoice uses qty (not quantity), and unit_price must be integer minor units (cents), e.g. $255.75 = 25575.",
   "author": "t05",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "Confirmed create_invoice accepts line items with qty and unit_price in integer cents; due_date 03/05/2027 represented May 3, 2027.",
   "author": "t07",
   "posted": 11,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "create_invoice requires due_date in DD/MM/YYYY format (e.g. 24/03/2027), with qty and integer-cent unit_price.",
   "author": "t08",
   "posted": 13,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  }
 ]
