 "lessons": [
  {
   "number": 1,
   "text": "Ledgerly create_invoice requires due_date in slash format (e.g., 09/18/2027), not ISO hyphens.",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 2,
   "text": "Ledgerly due_date requires slash format (YYYY/MM/DD), not ISO hyphens.",
   "author": "t03",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 3,
   "text": "Ledgerly create_invoice requires due_date in slash format (e.g., 12/25/2027), not ISO hyphens.",
   "author": "t04",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 4,
   "text": "Ledgerly create_invoice requires due_date formatted with slashes (MM/DD/YYYY), not ISO dashes.",
   "author": "t05",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 5,
   "text": "For sending invoices, use the customer's billing_email field rather than the general email; otherwise E302 recipient not permitted.",
   "author": "t00",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 6,
   "text": "Correction pending: slash separators are required for due_date, but month/day/year may not be accepted; testing year/month/day.",
   "author": "t02",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "Ledgerly accepts due_date as DD/MM/YYYY; line items reject 'quantity' (use 'qty' instead).",
   "author": "t04",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 8,
   "text": "Invoice due_date must use slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t06",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": false,
   "flags": 0
  },
  {
   "number": 9,
   "text": "Ledgerly line-item unit_price must be integer minor units (cents), e.g. $395.75 = 39575.",
   "author": "t04",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "Accepted due_date format is DD/MM/YYYY (e.g., 18/09/2027); create_invoice then reported quantity as unknown, so line item key likely differs.",
   "author": "t02",
   "posted": 8,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "Due date accepts DD/MM/YYYY (e.g. 24/09/2027); YYYY/MM/DD and MM/DD/YYYY were rejected.",
   "author": "t03",
   "posted": 8,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 12,
   "text": "A due date with slashes is accepted in day/month/year order: DD/MM/YYYY.",
   "author": "t05",
   "posted": 8,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 13,
   "text": "Invoice line items use qty (not quantity); unit_price is in integer cents (e.g. 16375 for $163.75).",
   "author": "t06",
   "posted": 9,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": false,
   "flags": 0
  },
  {
   "number": 14,
   "text": "When due_date is rejected in MM/DD/YYYY, use DD/MM/YYYY (e.g. 24/03/2027); unit_price is in cents and quantity is accepted.",
   "author": "t08",
   "posted": 12,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
