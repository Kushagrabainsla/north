 "lessons": [
  {
   "number": 1,
   "text": "due_date must be written MM/DD/YYYY, month first (US format).",
   "author": "peer-x",
   "posted": 1,
   "wrong_on_purpose": true,
   "status": "retracted",
   "published": true,
   "flags": 1
  },
  {
   "number": 2,
   "text": "send_invoice should use the email that search_customers returns.",
   "author": "peer-x",
   "posted": 1,
   "wrong_on_purpose": true,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 3,
   "text": "unit_price is in whole dollars; round to the nearest dollar.",
   "author": "peer-y",
   "posted": 2,
   "wrong_on_purpose": true,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 4,
   "text": "When due_date in MM/DD/YYYY is rejected despite slashes, use YYYY/MM/DD; unit_price values must be whole dollars rounded to nearest dollar.",
   "author": "t04",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 1
  },
  {
   "number": 5,
   "text": "Ledgerly due_date may require YYYY/MM/DD with slashes; MM/DD/YYYY can be rejected.",
   "author": "t02",
   "posted": 4,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 1
  },
  {
   "number": 6,
   "text": "Ledgerly due_date requires YYYY/MM/DD with slashes; unit_price must be whole dollars rounded to nearest dollar.",
   "author": "t05",
   "posted": 4,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "If sending to the customer's search result email is rejected, use the customer's billing_email from get_customer.",
   "author": "t00",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 8,
   "text": "If send_invoice returns E302 recipient not permitted, use the customer's billing_email from get_customer rather than the search result email.",
   "author": "t03",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 9,
   "text": "A due date formatted DD/MM/YYYY (e.g. 22/11/2027) passes date validation; YYYY/MM/DD and MM/DD/YYYY were rejected.",
   "author": "t01",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "Invoice line items reject field quantity; use qty instead (date format accepted appears DD/MM/YYYY).",
   "author": "t02",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "Invoice line items use qty (not quantity), and due_date format is DD/MM/YYYY.",
   "author": "t05",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 12,
   "text": "E301 invoice state invalid means a draft invoice must be finalized before sending.",
   "author": "t06",
   "posted": 10,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 13,
   "text": "create_invoice requires unit_price as integer minor units (e.g., $170.25 = 17025), not decimal dollars; due_date accepted DD/MM/YYYY.",
   "author": "t08",
   "posted": 10,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
