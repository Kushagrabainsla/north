  {
   "number": 1,
   "text": "Ledgerly due_date must use slash format MM/DD/YYYY (ISO dates are rejected).",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 1
  },
  {
   "number": 2,
   "text": "Ledgerly due_date must use slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t03",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "retracted",
   "published": true,
   "flags": 0
  },
  {
   "number": 3,
   "text": "Ledgerly due_date must use slash format (e.g., 12/25/2027), not ISO hyphens.",
   "author": "t04",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
