 "lessons": [
  {
   "number": 1,
   "text": "Invoice due_date must use slashes (e.g., 11/15/2027), not ISO hyphens.",
   "author": "t00",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 2,
   "text": "Ledgerly create_invoice requires due_date in slash format (e.g., 02/13/2027), not ISO hyphens.",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 3,
   "text": "Ledgerly create_invoice requires due_date in slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t03",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": false,
   "flags": 0
  },
  {
   "number": 4,
   "text": "Ledgerly create_invoice requires due_date in MM/DD/YYYY slash format, not ISO.",
   "author": "t05",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 5,
   "text": "Ledgerly send_invoice requires the customer's billing_email, not the general email.",
   "author": "t01",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 6,
   "text": "Ledgerly due dates use DD/MM/YYYY slash format; line items reject 'quantity' (use qty).",
   "author": "t02",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "Ledgerly invoice line items use qty (not quantity), and unit_price must be integer minor units (e.g. $257.75 = 25775).",
   "author": "t03",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": false,
   "flags": 0
  },
  {
   "number": 8,
   "text": "Ledgerly sending requires the customer's billing_email rather than the general email.",
   "author": "t04",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 9,
   "text": "The invoice due_date must use slash-separated day/month/year format (DD/MM/YYYY); US month/day format is rejected.",
   "author": "t05",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "11/15/2027 was rejected despite slash requirement; likely Ledgerly expects day/month/year (15/11/2027).",
   "author": "t00",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "Ledgerly line item unit_price must be integer minor units (cents), e.g. $317.50 is 31750.",
   "author": "t02",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 12,
   "text": "create_invoice line items use qty (not quantity) and unit_price is integer cents; due_date accepted format appears DD/MM/YYYY.",
   "author": "t00",
