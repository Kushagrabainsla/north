 "lessons": [
  {
   "number": 1,
   "text": "Ledgerly due_date must use slash format (e.g., 12/21/2027), not ISO hyphens.",
   "author": "t00",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 2,
   "text": "Ledgerly create_invoice requires due_date in slash format (MM/DD/YYYY), not ISO hyphens.",
   "author": "t02",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
