   "status": "unconfirmed",
   "published": true,
   "flags": 2
  },
  {
   "number": 2,
   "text": "send_invoice should use the email that search_customers returns.",
   "author": "peer-x",
   "posted": 1,
   "wrong_on_purpose": true,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 3,
   "text": "unit_price is in whole dollars; round to the nearest dollar.",
   "author": "peer-y",
   "posted": 2,
   "wrong_on_purpose": true,
   "status": "confirmed",
   "published": true,
   "flags": 1
  },
  {
   "number": 4,
   "text": "due_date in MM/DD/YYYY was rejected despite using slashes; likely requires a different slash-based date format.",
   "author": "t04",
   "posted": 3,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 5,
   "text": "E102 due_date rejects MM/DD/YYYY and YYYY/MM/DD; trying DD/MM/YYYY slash format.",
   "author": "t02",
   "posted": 4,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 6,
   "text": "send_invoice requires the customer's billing_email, not the primary email returned by search_customers.",
   "author": "t01",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 7,
   "text": "create_invoice accepts due_date in DD/MM/YYYY slash format; MM/DD/YYYY and YYYY/MM/DD are rejected.",
   "author": "t03",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 8,
   "text": "create_invoice accepts due_date in DD/MM/YYYY slash format; line items use qty rather than quantity.",
   "author": "t05",
   "posted": 5,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 9,
   "text": "create_invoice requires due_date as DD/MM/YYYY, line-item qty (not quantity), and unit_price as integer minor units (e.g. $316.25 = 31625).",
   "author": "t00",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 10,
   "text": "create_invoice accepts due_date DD/MM/YYYY; line items must use qty instead of quantity.",
   "author": "t02",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "unconfirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 11,
   "text": "create_invoice line items require 'qty' rather than 'quantity'; DD/MM/YYYY date format passed validation.",
   "author": "t04",
   "posted": 6,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 12,
   "text": "create_invoice line items require qty and unit_price in integer minor units (cents), e.g. $316.25 = 31625.",
   "author": "t03",
   "posted": 7,
   "wrong_on_purpose": false,
   "status": "confirmed",
   "published": true,
   "flags": 0
  },
  {
   "number": 13,
   "text": "create_invoice unit_price must be integer minor units (cents), e.g. $49.99 => 4999; use qty and DD/MM/YYYY.",
   "author": "t05",
