  "components": [
   {"id": "root", "component": "Column", "children": ["scene", "list"]},
   {"id": "scene", "component": "Select", "label": "Scene", "value": {"path": "/state/scene"}, "options": ["warm", "cool", "focus", "night"], "action": {"event": {"name": "scene"}}},
